{
  "name": "discord-community-suite",
  "version": "6.0.0",
  "private": true,
  "description": "Vietnamese Discord community suite with human-reviewed moderation, events, temporary voice, birthdays, polls, tickets and FAQ",
  "main": "dist/index.js",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "deploy:commands": "tsx src/deploy-commands.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "discord.js": "^14.25.1",
    "dotenv": "^16.6.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "type": "module"
}
